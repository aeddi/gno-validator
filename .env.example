# Password to decrypt the gnokms signing key.
# Optional and less safe — if not set, 'make up' and 'make update' will prompt for it at startup.
GNOKMS_PASSWORD=

# Optional — gno source version to build (branch, tag, or commit hash; default: master)
GNO_VERSION=master

# Optional — GitHub repo slug to clone gno sources from (default: gnolang/gno)
GNO_REPO=gnolang/gno

# Optional — host interface and port for gnoland RPC (defaults: 0.0.0.0, 26657)
# Use 127.0.0.1 to expose RPC only via a reverse proxy or keep it private.
GNOLAND_RPC_LADDR=0.0.0.0
GNOLAND_RPC_PORT=26657

# Optional — host interface and port for gnoland P2P (defaults: 0.0.0.0, 26656)
# Use 127.0.0.1 only if this node is not meant to accept inbound peer connections.
GNOLAND_P2P_LADDR=0.0.0.0
GNOLAND_P2P_PORT=26656

# Optional — host interface and port for Grafana web UI (defaults: 0.0.0.0, 3000)
# Use 127.0.0.1 to expose Grafana only via a reverse proxy or keep it private.
GRAFANA_LADDR=0.0.0.0
GRAFANA_PORT=3000

# Optional — Grafana admin credentials (defaults: admin / admin)
# Required to configure alerting or manage users.
# If GRAFANA_ADMIN_USER is set but GRAFANA_ADMIN_PASSWORD is not, 'make up' and
# 'make update' will prompt for the password at startup.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Optional — if set (to any non-empty value), passes --x-early-start to gnoland
GNOLAND_EARLY_START=

# Optional — if set (to any non-empty value), syncs the system clock via NTP at startup (default: 1)
GNOLAND_NTP_UPDATE=1

# Optional — number of 1 GB gnoland log files to keep (default: 30)
GNOLAND_LOG_SIZE=

# Optional — Grafana SMTP settings for email alerting
# Set GRAFANA_SMTP_ENABLED=true and fill in the remaining fields to enable.
GRAFANA_SMTP_ENABLED=
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_FROM_ADDRESS=
GRAFANA_SMTP_FROM_NAME=

# Optional and less safe — if not set and GRAFANA_SMTP_ENABLED=true, 'make up' and 'make update' will prompt for it at startup.
GRAFANA_SMTP_PASSWORD=

# Optional — Grafana alerting: comma-separated email addresses to notify (requires GRAFANA_SMTP_ENABLED=true)
GRAFANA_ALERT_EMAIL_ADDRESSES=

# Optional — Grafana alerting: seconds without a new block before triggering an alert (default: 300)
# Minimum effective value is ~90s: the alert uses increase() over this window, which requires at
# least 2 data points from the gnoland OTLP push interval (~60s). Values below ~90s risk returning
# no data intermittently and missing alerts. The default of 300s is recommended for production.
GRAFANA_BLOCK_STALL_SECONDS=
