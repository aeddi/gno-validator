# Local secrets
.env

# Node config — gitignored so each operator's settings stay local
config.overrides

# Generated at runtime — not tracked (genesis.json is ~200 MB)
genesis.json

# Node data — contains secrets and chain state
gnoland-data/
gnokms-data/

# Downloaded lnav binary — fetched on demand, not tracked
.lnav/bin/

# reverse-proxy — local secrets and generated files
reverse-proxy/.env
reverse-proxy/www/index.html
