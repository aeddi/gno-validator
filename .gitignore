# Local secrets
validator.env

# Node config — gitignored so each operator's settings stay local
config.overrides

# Sentinel config — local to each operator (watchtower URL + token)
sentinel.toml

# Generated at runtime — not tracked (genesis.json is ~200 MB)
genesis.json

# Node data — contains secrets and chain state
gnoland-data/
gnokms-data/

# Downloaded tool binaries (gonzo, jq) — fetched on demand, not tracked
.tools/bin/

# reverse-proxy — local config and generated files
reverse-proxy/config
reverse-proxy/caddy-data/

# Build state snapshot — written by 'make build', consumed by 'make start'/'update'
.build-state
