# Password to decrypt the gnokms signing key.
# Optional and less safe — if not set, 'make start' and 'make update' will prompt for it at startup.
GNOKMS_PASSWORD=

# Optional — gno source version to build (branch, tag, or commit hash; default: master)
GNO_VERSION=master

# Optional — GitHub repo slug to clone gno sources from (default: gnolang/gno)
GNO_REPO=gnolang/gno

# Optional — sentinel image tag to pull from ghcr.io/aeddi/gno-watchtower/sentinel
# (default: latest). Pin to a specific tag or digest (e.g. sha256:abc123...) for
# reproducibility. When set to a tag like 'latest', make build/start/update
# check ghcr for a newer digest and report drift.
SENTINEL_IMAGE_TAG=latest

# Optional — host interface and port for gnoland RPC (defaults: 0.0.0.0, 26657)
# Use 127.0.0.1 to expose RPC only via a reverse proxy or keep it private.
GNOLAND_RPC_LADDR=0.0.0.0
GNOLAND_RPC_PORT=26657

# Optional — host interface and port for gnoland P2P (defaults: 0.0.0.0, 26656)
# Use 127.0.0.1 only if this node is not meant to accept inbound peer connections.
GNOLAND_P2P_LADDR=0.0.0.0
GNOLAND_P2P_PORT=26656

# Optional — if set (to any non-empty value), passes --x-early-start to gnoland
GNOLAND_EARLY_START=

# Optional — if set (to any non-empty value), syncs the system clock via NTP at startup (default: 1)
GNOLAND_NTP_UPDATE=1

# Optional — number of 1 GB gnoland log files to keep (default: 3)
GNOLAND_LOG_SIZE=
