# gnoland node config overrides (optional).
# Applied to gnoland-data/config/config.toml via 'gnoland config set' on each
# container start, BEFORE the system-hardcoded overrides listed below.
# Format: key = value (one per line; # for comments; blank lines ignored)

# ---- System-hardcoded keys (overridden by the entrypoint, cannot be customized)
# p2p.laddr                                              = "tcp://0.0.0.0:26656"        # in-container P2P bind (see validator.env for host listener/port)
# rpc.laddr                                              = "tcp://0.0.0.0:26657"        # in-container RPC bind (see validator.env for host listener/port)
# consensus.priv_validator.remote_signer.server_address  = "unix:///sock/gnokms.sock"   # gnokms socket
# telemetry.metrics_enabled                              = true
# telemetry.traces_enabled                               = true
# telemetry.exporter_endpoint                            = "http://sentinel:4318"

# ---- Required node settings
moniker = "anon-val-01"
p2p.external_address = "<public-ip-or-domain>:26656"
p2p.persistent_peers = "<node-id>@<host>:26656,..."
telemetry.service_instance_id = "anon-val-01" # Node ID in Grafana
telemetry.service_name = "<chain-id-or-similar>" # Service ID in Grafana

# ---- Recommended settings for a validator node
consensus.peer_gossip_sleep_duration = "10ms"
consensus.timeout_commit = "3s"
mempool.size = 10000
p2p.flush_throttle_timeout = "10ms"
p2p.max_num_outbound_peers = 40
